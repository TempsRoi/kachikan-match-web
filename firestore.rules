rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // データ操作は、Firebase IDトークンを検証するNext.js Route Handlerから
    // Firebase Admin SDK経由でのみ行う。Admin SDKはSecurity Rulesを迂回する。
    // ブラウザからの直接読み書きは、認証状態にかかわらず許可しない。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
